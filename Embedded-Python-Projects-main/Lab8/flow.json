        "type": "ui_template",
        "z": "lab8flow00000001",
        "group": "lab8group0000001",
        "name": "Status",
        "order": 1,
        "width": 3,
        "height": 3,
        "format": "<div class=\"st\">\n  <div class=\"st-title\">Status</div>\n  <div class=\"st-row\">\n    <span class=\"st-dot\" ng-class=\"msg.payload === 'online' ? 'on' : 'off'\"></span>\n    <span class=\"st-text\">{{ msg.payload === 'online' ? 'ONLINE' : 'OFFLINE' }}</span>\n  </div>\n  <div class=\"st-time\" ng-if=\"msg.time\">{{ msg.time }}</div>\n</div>\n<style>\n  .st { display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; gap:6px; }\n  .st-title { font-size:14px; opacity:.8; }\n  .st-row { display:flex; align-items:center; gap:8px; }\n  .st-dot { width:18px; height:18px; border-radius:50%; }\n  .st-dot.on { background:#2ecc71; box-shadow:0 0 8px #2ecc71; }\n  .st-dot.off { background:#e74c3c; }\n  .st-text { font-size:22px; font-weight:bold; }\n  .st-time { font-size:11px; opacity:.6; text-align:center; }\n</style>",
