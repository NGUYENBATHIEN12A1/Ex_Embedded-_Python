        "order": 2,
        "width": 4,
        "height": 6,
        "format": "<div class=\"info\" ng-if=\"msg.payload\">\n  <div><span>Tên</span><b>{{ msg.payload.name }}</b></div>\n  <div><span>IP</span><b>{{ msg.payload.ip }}</b></div>\n  <div><span>MAC</span><b>{{ msg.payload.mac }}</b></div>\n  <div><span>Broker</span><b>{{ msg.payload.broker }}</b></div>\n  <div><span>Client ID</span><b>{{ msg.payload.client_id }}</b></div>\n  <div><span>Cảm biến</span><b>{{ msg.payload.sensor }}</b></div>\n</div>\n<div class=\"info-empty\" ng-if=\"!msg.payload\">Chưa nhận được thông tin từ ESP32</div>\n<style>\n  .info div { display:flex; justify-content:space-between; gap:8px; padding:6px 0; border-bottom:1px solid rgba(128,128,128,.25); }\n  .info span { opacity:.7; }\n  .info b { text-align:right; word-break:break-all; }\n  .info-empty { opacity:.6; padding-top:12px; }\n</style>",
