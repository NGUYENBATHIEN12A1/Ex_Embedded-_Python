    {
        "id": "vkufuncinfo00001",
        "type": "function",
        "z": "vkuweatherflow01",
        "name": "Device info",
        "func": "// Merges data and status messages into one device info table\nconst info = context.get('info') || { status: '—', updated: '—', errors: '—', rssi: '—', interval: '—', seq: '—' };\nif (msg.topic === 'status') info.status = msg.payload;\nelse Object.assign(info, msg.payload);\ncontext.set('info', info);\nmsg.payload = [\n    ['Status', info.status],\n    ['Last update', info.updated],\n    ['Sensor errors', info.errors],\n    ['Wi-Fi RSSI', info.rssi],\n    ['Interval', info.interval],\n    ['Sequence (seq)', info.seq],\n];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 380,
        "wires": [
            [
                "vkutplinfo000001"
            ]
        ]
    },
    {
        "id": "vkutplinfo000001",
        "type": "ui_template",
        "z": "vkuweatherflow01",
        "group": "vkugroupdev00001",
        "name": "Device table",
        "order": 1,
        "width": 6,
        "height": 6,
        "format": "<table style=\"width:100%; border-collapse:collapse; font-size:15px\">\n    <tr ng-repeat=\"row in msg.payload\" style=\"border-bottom:1px solid #eee\">\n        <td style=\"padding:10px 0; color:#555\">{{row[0]}}</td>\n        <td style=\"padding:10px 0; text-align:right; font-weight:600\">{{row[1]}}</td>\n    </tr>\n</table>",
        "storeOutMessages": true,
        "fwdInMessages": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 880,
        "y": 380,
        "wires": [
            []
        ]
    },
    {
        "id": "vkufuncalert0001",
        "type": "function",
        "z": "vkuweatherflow01",
        "name": "Check thresholds",
        "func": "// Alert thresholds (lo/hi = null disables that side); the same alert repeats at most every COOLDOWN_MS\nconst DEVICE = 'esp32-01';\nconst LIMITS = {\n    temperature: { lo: null, hi: 35, name: 'Temperature', unit: '°C' },\n    humidity: { lo: 30, hi: 90, name: 'Humidity', unit: '%' },\n    light: { lo: 50, hi: null, name: 'Light', unit: 'lux' },\n};\nconst COOLDOWN_MS = 300000;\n\nconst r = msg.payload;\nif (typeof r !== 'object' || r === null || r.device_id !== DEVICE) return null;\n\nconst last = context.get('last') || {};\nconst now = Date.now();\nconst out = [];\nfor (const [key, l] of Object.entries(LIMITS)) {\n    const v = r[key];\n    if (v === null || v === undefined) continue;\n    let text = null;\n    if (l.hi !== null && v > l.hi) text = `${l.name} high: ${v} ${l.unit} (limit ${l.hi})`;\n    else if (l.lo !== null && v < l.lo) text = `${l.name} low: ${v} ${l.unit} (limit ${l.lo})`;\n    if (!text || now - (last[key] || 0) < COOLDOWN_MS) continue;\n    last[key] = now;\n    out.push({ topic: '⚠ Alert ' + r.device_id, payload: text });\n}\ncontext.set('last', last);\nreturn [out];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 540,
        "wires": [
            [
                "vkutoastalert001"
            ]
        ]
    },
