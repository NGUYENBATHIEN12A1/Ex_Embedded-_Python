    {
        "id": "vkufuncsplit0001",
        "type": "function",
        "z": "vkuweatherflow01",
        "name": "Split readings",
        "func": "// Shows a single device; change DEVICE if you use a different device_id\nconst DEVICE = 'esp32-01';\nconst r = msg.payload;\nif (typeof r !== 'object' || r === null || r.device_id !== DEVICE) return null;\n\nconst val = (v, topic) => (v === null || v === undefined) ? null : { payload: v, topic };\nconst t = r.ts ? new Date(r.ts * 1000) : new Date();\n\nreturn [\n    val(r.temperature, 'Temperature'),\n    val(r.humidity, 'Humidity'),\n    val(r.pressure, 'Pressure'),\n    val(r.light, 'Light'),\n    val(r.temperature, 'Temperature'),\n    val(r.humidity, 'Humidity'),\n    val(r.pressure, 'Pressure'),\n    val(r.light, 'Light'),\n    {\n        topic: 'data', payload: {\n            updated: t.toLocaleString('en-GB', { timeZone: 'Asia/Ho_Chi_Minh' }),\n            errors: r.errors && r.errors.length ? '⚠ ' + r.errors.join(', ') : 'None',\n            rssi: r.rssi !== null && r.rssi !== undefined ? r.rssi + ' dBm' : '—',\n            interval: r.interval ? r.interval + ' s' : '—',\n            seq: r.seq !== null && r.seq !== undefined ? r.seq : '—',\n        },\n    },\n];",
        "outputs": 9,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 100,
        "wires": [
            [
                "vkugaugetemp0001"
            ],
            [
                "vkugaugehum00001"
            ],
            [
                "vkugaugepres0001"
            ],
